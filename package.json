{
  "name": "zustand-querystring-root",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter=zustand-querystring build && pnpm -r --filter=!zustand-querystring build",
    "build:example:react": "pnpm -r --filter=zustand-querystring build && pnpm -r --filter=react build",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "release": "pnpm build && bumpp package.json packages/*/package.json examples/*/package.json && pnpm -r publish --access=public"
  },
  "devDependencies": {
    "bumpp": "^8.2.1",
    "prettier": "^3.3.3"
  },
  "engines": {},
  "pnpm": {
    "overrides": {
      "zustand-querystring": "link:./packages/zustand-querystring/"
    }
  },
  "packageManager": "pnpm@9.6.0"
}
